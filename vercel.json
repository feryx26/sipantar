{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/backend/index.js"
    }
  ],
  "functions": {
    "backend/index.js": {
      "runtime": "vercel-node@latest",
      "includeFiles": "backend/dist/**"
    }
  }
}
