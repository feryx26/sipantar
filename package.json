{
  "name": "sipantar",
  "version": "1.0.0",
  "description": "SIPANTAR - Sistem Informasi Pantau Harga Pasar",
  "main": "backend/index.js",
  "scripts": {
    "build": "node vercel-build.js",
    "start": "cd backend && npm start",
    "dev": "concurrently \"npm run dev-backend\" \"npm run dev-frontend\"",
    "dev-backend": "cd backend && npx nodemon index.js",
    "dev-frontend": "cd frontend && npm run dev"
  },
  "keywords": ["pasar", "harga", "monitoring", "komoditas"],
  "author": "SIPANTAR Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
